Algoritmo "L05A"
// Descrição   : Apresentar os quadrados dos números inteiros de 15 a 200
// Autor(a)    : João Pedro Gomes
// Data atual  : 27/09/2026
Var
   i, quadrado: inteiro

Inicio
   para i de 15 ate 200 faca
      quadrado <- i * i
      Escreval("O quadrado de ", i, " é: ", quadrado)
   fimpara

Fimalgoritmo